{
  "name": "dsh-ops-android",
  "version": "1.0.0",
  "description": "Android 端「省 token 操作原语」：紧凑读屏(ops_ui_digest)、一步式查找+动作(ops_ui_find)、内置轮询等待(ops_ui_wait)、批量步骤(ops_ui_seq)、批量特权 shell(ops_shell)。为手机 UI 自动化消除多余往返与冗长输出。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "ops",
    "token-efficiency",
    "ui-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
